[Unit]
Description=Servidor de pareamento do BLACK PLUS TV
After=network.target

[Service]
User=blackplus
WorkingDirectory=/opt/blackplus-pair
Environment=PORT=8787
Environment=HOST=127.0.0.1
Environment=TRUST_PROXY=1
ExecStart=/usr/bin/node /opt/blackplus-pair/server.cjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
